[{"bbox": [630, 140, 340, 80], "original": "神啊。", "translation": "神啊。"}, {"bbox": [380, 30, 200, 60], "original": "この戦いで、", "translation": "这场战斗中、"}, {"bbox": [350, 100, 230, 60], "original": "俺の勝利条件", "translation": "我的胜利条件"}, {"bbox": [320, 170, 260, 60], "original": "確認させて", "translation": "请容我确认一下。"}, {"bbox": [80, 220, 150, 50], "original": "ユボーン、", "translation": "尤本、"}, {"bbox": [300, 220, 150, 50], "original": "ヒノモト、", "translation": "日之元、"}, {"bbox": [80, 280, 150, 50], "original": "ドミン、", "translation": "多明、"}, {"bbox": [300, 280, 180, 50], "original": "ゼン様の", "translation": "以及善先生的"}, {"bbox": [30, 340, 150, 50], "original": "心臓を手に", "translation": "心脏握在手中"}, {"bbox": [380, 340, 160, 50], "original": "お側へ", "translation": "前往您的身边"}, {"bbox": [200, 390, 160, 50], "original": "参上します", "translation": "前去参见。"}, {"bbox": [100, 440, 450, 100], "original": "ゼン様の心臓とは", "translation": "所谓善先生的心脏，是指善先生身体里的那个东西吗？"}, {"bbox": [280, 580, 150, 60], "original": "変わりますか", "translation": "会改变吗？"}, {"bbox": [60, 580, 180, 60], "original": "元の自分に", "translation": "变回原本的自己。"}, {"bbox": [100, 650, 400, 60], "original": "人の心臓を失っても死なず", "translation": "即使失去人的心脏也不会死"}, {"bbox": [280, 760, 160, 60], "original": "神と等しくなる", "translation": "成为与神等同的"}, {"bbox": [60, 760, 150, 60], "original": "存在。", "translation": "存在。"}]